<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark/Night Theme -->
    <style name="Theme.Project_pendidikan" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/green_200</item>
        <item name="colorPrimaryVariant">@color/green_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/grey_900</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/grey_900</item>
        <item name="backgroundColor">@color/grey_900</item>
        <!-- Text colors -->
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorSecondary">@color/grey_400</item>
        <!-- Card colors -->
        <item name="cardBackgroundColor">@color/grey_800</item>
        
        <!-- TextInputLayout styles -->
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox</item>
        <!-- Custom colors for TextInputLayout -->
        <item name="colorControlActivated">@color/green_200</item>
        <item name="colorControlNormal">@color/grey_400</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColorHint">@color/grey_400</item>
        <!-- Search background -->
        <item name="colorSurface">@color/grey_800</item>
        <item name="colorOnSurface">@color/white</item>
        
        <!-- Toolbar specific colors -->
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="actionBarStyle">@style/Widget.App.ActionBar</item>
        <item name="actionMenuTextColor">@color/white</item>
        <item name="android:actionMenuTextColor">@color/white</item>
    </style>

    <!-- Custom style for TextInputLayout in dark mode -->
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/green_200</item>
        <item name="hintTextColor">@color/green_200</item>
        <item name="android:textColorHint">@color/grey_400</item>
        <item name="boxBackgroundColor">@color/grey_800</item>
    </style>

    <!-- Custom Toolbar style -->
    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="titleTextColor">@color/green_200</item>
        <item name="subtitleTextColor">@color/grey_400</item>
        <item name="android:background">@color/grey_800</item>
        <item name="android:elevation">0dp</item>
        <item name="android:theme">@style/ThemeOverlay.App.Toolbar</item>
    </style>

    <!-- Custom ActionBar style -->
    <style name="Widget.App.ActionBar" parent="Widget.MaterialComponents.ActionBar.Surface">
        <item name="background">@color/grey_800</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Theme overlay for toolbar -->
    <style name="ThemeOverlay.App.Toolbar" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface">
        <item name="colorOnSurface">@color/white</item>
        <item name="actionMenuTextColor">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>
</resources>